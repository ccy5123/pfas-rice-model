diff --git a/src/literature_params.py b/src/literature_params.py
index 7db4921..a61495b 100644
--- a/src/literature_params.py
+++ b/src/literature_params.py
@@ -379,7 +379,45 @@ KPL_ANCHOR_LKG = 10.0 ** KMW_CHEN2025_LOG["PFOA"]   # measured PFOA anchor (~190
 KPL_ANCHOR_NPFC = 7
 KPROT_ANCHOR_LKG = 12.0        # K_prot last-resort fallback [L/kg] (~ measured soy PFOA),
                                # used only if a congener is absent from KPROW_ZHOU2025_LOG
-KCW_ANCHOR_LKG = 20.0          # K_cw cell-wall  [PLACEHOLDER -- no coefficient in literature]
+# K_cw for a structure without a curated record: the GAP A ladder (docs/DELIVERABLE_GAP_A_Kcw.md;
+# params/Kcw_Klignin_params_v2.csv) -- K_poly and K_lignin interpolated log-linearly in the number
+# of perfluorinated carbons within the head-group class (PFCA, PFSA), extrapolated beyond the table
+# at the ladder's +0.10 log per CF2; an ether acid is read as a carboxylate (GAP A has no ether row).
+KCW_PER_CF2_LOG = 0.10
+
+
+def kcw_pools(n_cf: int, head_group: str = "carboxylate") -> tuple[float, float]:
+    """(K_cw_poly, K_lignin) [L/kg pool dw] of a PFAS with `n_cf` perfluorinated carbons."""
+    import csv as _csv
+    import os as _os
+    path = _os.path.join(_os.path.dirname(_os.path.dirname(_os.path.abspath(__file__))),
+                         "params", "Kcw_Klignin_params_v2.csv")
+    cls = "PFSA" if head_group == "sulfonate" else "PFCA"
+    with open(path) as f:
+        rows = [r for r in _csv.DictReader(f) if r["class"] == cls]
+    n = np.array([float(r["n_CF"]) for r in rows])
+    order = np.argsort(n)
+    n = n[order]
+    out = []
+    for col in ("K_cw_poly_rec", "K_lignin_rec"):
+        lk = np.log10([float(rows[i][col]) for i in order])
+        x = float(n_cf)
+        if x < n[0]:
+            v = lk[0] - KCW_PER_CF2_LOG * (n[0] - x)
+        elif x > n[-1]:
+            v = lk[-1] + KCW_PER_CF2_LOG * (x - n[-1])
+        else:
+            v = float(np.interp(x, n, lk))
+        out.append(float(10.0 ** v))
+    return out[0], out[1]
+
+
+def kcw_wholecw(n_cf: int, head_group: str, lignin_share: float) -> float:
+    """Whole-cell-wall K_cw of an organ with the given lignin share of its cell wall:
+    (1 - s) K_poly + s K_lignin (the GAP A organ mix)."""
+    kp, kl = kcw_pools(n_cf, head_group)
+    s = float(lignin_share)
+    return (1.0 - s) * kp + s * kl
 # Plant storage proteins (soy protein isolate) bind PFAS WEAKER than serum
 # albumin -- now captured DIRECTLY by the measured K_prow (zhou2025 Table 1), so
 # NO scale factor is needed: plant/grain tissues use protein="soy", animal "bsa".
@@ -638,7 +676,7 @@ def literature_compound(name: str | None = None, *,
                         Vmax_out: float = 8.0, Km_out: float = 5.0,
                         kpl_anchor: float = KPL_ANCHOR_LKG,
                         kprot_anchor: float = KPROT_ANCHOR_LKG,
-                        kcw_anchor: float = KCW_ANCHOR_LKG) -> Compound:
+                        kcw_anchor: float | None = None) -> Compound:
     """Build a :class:`Compound` with literature-derived binding & speciation.
 
     Binding (``K_prot``, ``K_PL``) scales with chain length via the verified C4
@@ -651,6 +689,8 @@ def literature_compound(name: str | None = None, *,
         raise ValueError("provide a known `name` (in SPECIES) or both "
                          "`n_perfluoroC` and `head_group`")
     label = name or f"PF{n_perfluoroC}{'S' if head_group == 'sulfonate' else 'A'}"
+    if kcw_anchor is None:                 # the GAP A ladder, cell-wall pools in equal shares
+        kcw_anchor = kcw_wholecw(n_perfluoroC, head_group, 0.5)
     return Compound(
         name=label,
         K_prot=k_prot(n_perfluoroC, plant=plant_protein, anchor=kprot_anchor, name=name),
