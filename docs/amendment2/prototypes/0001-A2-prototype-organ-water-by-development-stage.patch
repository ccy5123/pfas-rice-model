@@ -0,0 +1,124 @@
+"""Organ water that follows the development stage (amendment 2 prototype).
+
+Pinned: (1) theta(DVS) is linear between the sourced anchors and flat outside them, and the
+dry -> fresh conversion is undone exactly by `dry_from_fresh`; (2) with staged water the
+models still conserve mass (the burden C*M_fresh changes only by uptake and loss, whatever
+the water does) and the flux mirror still equals rhs(); (3) the grain phloem stream is per kg
+of DRY growth taken from the dry driver; (4) the harvest operator reports burden / dry matter.
+"""
+import os
+import sys
+
+import numpy as np
+import pytest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(ROOT, "src"))
+
+import organ_mass as om                                    # noqa: E402
+import apportionment as ap                                  # noqa: E402
+from model_api import PHI, T_C_PH                           # noqa: E402
+from pfas_rice_plant_module_4pool_surf import (            # noqa: E402
+    Environment, Compound, Compartment, PlantInputs, RiceUptakeModel, binding_factors,
+    root_uptake, _logistic)
+from pfas_rice_plant_module_nstem_leaf import (            # noqa: E402
+    NStemLeafModel, PlantInputsNL, make_stem_leaf_compartments, default_tau)
+
+STAGE = {"root": [[0.65, 0.82], [2.0, 0.64]], "stem": [[0.65, 0.82], [2.0, 0.71]],
+         "leaf": [[0.65, 0.73], [2.0, 0.66]], "grain": [[1.0, 0.58], [2.0, 0.21]]}
+
+
+def _cmpd():
+    return Compound(name="x", K_prot=12.3, K_PL=1905.0, K_cw=6.5, kappa_d=0.0, Vmax_in=0.0,
+                    Km_in=1.0, Vmax_out=0.0, Km_out=1.0, L_Ph=0.05, f_xy=0.04,
+                    r_eq=2.0, lam_eq=1e4, g_xy=0.002, g_ph=0.0)
+
+
+def _drivers(t):
+    dvs = np.clip(t / 75.0, 0.0, 2.0)
+    dry = np.column_stack([_logistic(t, 1e-4, 0.004, 0.10, 20.0), _logistic(t, 1e-4, 0.010, 0.11, 30.0),
+                           _logistic(t, 1e-4, 0.005, 0.11, 30.0), _logistic(t, 1e-8, 0.012, 0.18, 95.0)])
+    th = np.column_stack([np.interp(dvs, *np.array(STAGE[o]).T) for o in om.ORGANS])
+    return dvs, dry, dry / (1.0 - th)
+
+
+def test_theta_is_linear_between_anchors_and_flat_outside():
+    a = om.THETA_STAGE["root"]
+    assert om.theta_at("root", 0.0) == pytest.approx(a[0, 1])          # flat before
+    assert om.theta_at("root", 2.5) == pytest.approx(a[-1, 1])         # flat after
+    mid = 0.5 * (a[0, 0] + a[1, 0])
+    assert om.theta_at("root", mid) == pytest.approx(0.5 * (a[0, 1] + a[1, 1]))
+    assert om.theta_at("root") == om.THETA_FW["root"]                  # no stage: constant
+    t = np.linspace(0, 120, 50)
+    b = {"root": t * 1e-4 + 1e-6, "stem": t * 2e-4 + 1e-6, "leaf": t * 1e-4 + 1e-6,
+         "grain": t * 5e-5 + 1e-6, "dvs": np.clip(t / 60.0, 0, 2)}
+    M = np.column_stack([om.to_model_mass(b)[o] for o in om.ORGANS])
+    assert np.allclose(om.dry_from_fresh(M, b["dvs"]), np.column_stack([b[o] for o in om.ORGANS]))
+
+
+def _comps4():
+    return [Compartment("root", 0.8, 0.06, 0.02, 0.5, theta_dvs=STAGE["root"]),
+            Compartment("stem", 0.8, 0.07, 0.003, 0.7, theta_dvs=STAGE["stem"]),
+            Compartment("leaf", 0.7, 0.2, 0.009, 0.4, theta_dvs=STAGE["leaf"]),
+            Compartment("grain", 0.2, 0.09, 0.001, 0.04, theta_dvs=STAGE["grain"])]
+
+
+def test_4pool_flux_mirror_and_mass_with_staged_water():
+    t = np.linspace(0.0, 150.0, 301)
+    dvs, dry, M = _drivers(t)
+    inp = PlantInputs(t=t, Cwo=np.ones_like(t), Qtp=0.05 + 0.1 * np.exp(-((t - 90) / 30) ** 2),
+                      M=M, M_basis="fresh", dvs=dvs, M_dry=dry)
+    m = RiceUptakeModel(env=Environment(), cmpd=_cmpd(), comps=_comps4(), inputs=inp,
+                        phi=PHI, T_C_Ph=T_C_PH, lam_grain_dvs=(0.21, 0.07))
+    rng = np.random.default_rng(1)
+    for ti in (20.0, 80.0, 120.0):
+        C = rng.uniform(0.0, 30.0, 4)
+        assert np.allclose(m.rhs(ti, C), ap.dC_from_fluxes(m, ti, C), rtol=1e-9, atol=1e-12)
+    # the burden changes only by root entry (no loss, no metabolism, no air)
+    sol = m.solve(t)
+    for ti in (60.0, 110.0):
+        C = sol.sol(ti); dC = m.rhs(ti, C)
+        Cwo, Q, Mi, dM, ll, gam, dv, dMd = inp.drivers_at(ti)
+        B = binding_factors(m.comps, m.cmpd, dv)
+        jR = root_uptake(Cwo, C[0] / B[0], m.cmpd, m.env)
+        assert float(np.sum(dM * C + Mi * dC)) == pytest.approx(float(Mi[0] * jR), rel=1e-6, abs=1e-9)
+
+
+def test_redistributed_mass_with_staged_water():
+    N = 4
+    t = np.linspace(0.0, 150.0, 301)
