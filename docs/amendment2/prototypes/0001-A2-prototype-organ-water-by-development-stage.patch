diff --git a/src/organ_mass.py b/src/organ_mass.py
index e1e98a2..777363e 100644
--- a/src/organ_mass.py
+++ b/src/organ_mass.py
@@ -27,11 +27,10 @@ so the mass basis and the concentration basis cannot drift apart.
 Driver dicts carry the tag `mass_basis="fresh"` (MASS_BASIS) so the one place that needs
 dry matter -- the leaf/grain xylem split -- can take it back out (`xylem_leaf_share`).
 
-LIMITATIONS (docs/sampling_protocols_audit_KR.md): theta_fw is held constant over
-the season (grain 0.14 is harvest moisture; filling grain is ~0.5-0.6 water, mature
-straw dries to 0.1-0.5), and the root/stem/leaf values are estimates -- no rice
-dataset in the repo, nor any found in the literature audit, reports organ water
-content over a season.
+theta_fw follows the crop's development stage (`theta_at`): linear in DVS between sourced
+anchors (params/rice_theta_stage_sourced.csv) -- the root dries from ~0.82 in the vegetative
+phase to ~0.64 at maturity, the grain from 0.58 early in filling to 0.21 at harvest. A driver
+without stage falls back to the constant composition-table value `THETA_FW`.
 """
 from __future__ import annotations
 
@@ -53,25 +52,60 @@ def _load_theta():
     return {o: float(comp[k]["theta_fw"]) for o, k in _COMP_KEY.items()}
 
 
-THETA_FW = _load_theta()
+THETA_FW = _load_theta()          # constant fallback for a driver without development stage
 
 
-def fresh_factor(organ):
-    """Multiplier dry -> fresh organ mass: 1/(1-theta_fw)."""
-    return 1.0 / (1.0 - THETA_FW[organ])
+def _load_stage():
+    """organ -> array [[dvs, theta], ...] of the sourced stage anchors (theta at each anchor's
+    midpoint; params/rice_theta_stage_sourced.csv via parameters.json["theta_stage"])."""
+    with open(os.path.join(_ROOT, "params", "parameters.json")) as f:
+        st = json.load(f).get("theta_stage") or {}
+    anc = st.get("anchors", {})
+    return {o: np.asarray(anc[k], float)[:, :2] for o, k in _COMP_KEY.items() if k in anc}
+
+
+THETA_STAGE = _load_stage()
+
+
+def theta_at(organ, dvs=None):
+    """theta_fw of `organ` at development stage(s) `dvs`: linear in DVS between the sourced
+    anchors and flat outside them. A driver without stage (dvs None, or NaN entries) uses the
+    constant `THETA_FW`."""
+    a = THETA_STAGE.get(organ)
+    if dvs is None or a is None:
+        return THETA_FW[organ] if dvs is None or np.ndim(dvs) == 0 else \
+            np.full(np.shape(dvs), THETA_FW[organ])
+    d = np.asarray(dvs, float)
+    th = np.where(np.isfinite(d), np.interp(np.nan_to_num(d), a[:, 0], a[:, 1]), THETA_FW[organ])
+    return float(th) if th.ndim == 0 else th
+
+
+def fresh_factor(organ, dvs=None):
+    """Multiplier dry -> fresh organ mass: 1/(1-theta_fw), at stage `dvs` when given."""
+    return 1.0 / (1.0 - theta_at(organ, dvs))
 
 
 def to_model_mass(b):
     """Convert a crop-model biomass dict {root,stem,leaf,grain: DRY kg/hill, ...} to FRESH
-    organ mass. Non-organ keys (e.g. ORYZA's `leaf_death_rate`, a RELATIVE rate that a
-    constant factor leaves unchanged) are passed through untouched."""
+    organ mass, with each organ's water at the driver's development stage (`b["dvs"]`) when
+    it carries one. Non-organ keys (e.g. ORYZA's `leaf_death_rate`, a RELATIVE rate of the
+    dry leaf, which applies to the burden unchanged) are passed through untouched."""
     out = dict(b)
+    dvs = b.get("dvs")
     for o in ORGANS:
         if o in b and b[o] is not None:
-            out[o] = np.asarray(b[o], float) * fresh_factor(o)
+            out[o] = np.asarray(b[o], float) * fresh_factor(o, dvs)
     return out
 
 
+def dry_from_fresh(M, dvs=None):
+    """(n, 4) DRY matter from an (n, 4) FRESH matrix with the same organ water (`theta_at`)
+    that made it fresh -- the dry growth the grain phloem stream is per kg of, and the dry
+    basis of the harvest operator."""
+    M = np.asarray(M, float)
+    return np.column_stack([M[:, i] * (1.0 - theta_at(o, dvs)) for i, o in enumerate(ORGANS)])
+
+
 # The ODE divides by organ mass, so an organ the crop model has not formed yet (the grain
