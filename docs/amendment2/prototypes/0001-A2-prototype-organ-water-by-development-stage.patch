+    kw = lambda o, th, fp, fpl, fcw: dict(theta=th, f_prot=fp, f_PL=fpl, f_cw=fcw, theta_dvs=STAGE[o])
+    comps = make_stem_leaf_compartments(N, kw("stem", .8, .07, .003, .7), kw("root", .8, .06, .02, .5),
