index 0000000..f570f4f
--- /dev/null
+++ b/params/rice_theta_stage_sourced.csv
@@ -0,0 +1,16 @@
+# Organ water content theta_fw (water / fresh mass) by crop development stage (ORYZA DVS), from the
+# rice measurements in docs/literature_db/sourced_inputs.csv (tis_theta_*). Between anchors theta is
+# linear in DVS and flat outside them (the linear form is a stated assumption, as for the panicle's
+# transpiration share). low/high = the sourced range at the anchor; the model runs at the midpoint and
+# the input-range band carries the ends. An anchor at DVS 0.65 holds from transplanting to panicle
+# initiation (seedling and vegetative measurements carry no finer stage). Stem: no stem-only source;
+# whole-shoot values stand in.
+organ,dvs,low,high,basis,source
+root,0.65,0.761,0.888,"seedling to vegetative; hydroponic and flooded soil pots (4 studies)",tis_theta_root
+root,2.0,0.506,0.767,"maturity; soil pots (6 studies)",tis_theta_root
+stem,0.65,0.726,0.910,"whole shoot, seedling to vegetative (soil pots 56 d after sowing; hydroponic seedlings)",tis_theta_root (shoot columns)
+stem,2.0,0.645,0.774,"whole shoot 10-45 d after flowering and straw at maturity",tis_theta_stem
+leaf,0.65,0.731,0.731,"leaf at tillering (183 accessions)",tis_theta_leaf
+leaf,2.0,0.659,0.659,"flag leaf at maturity",tis_theta_leaf
+grain_brown,1.0,0.58,0.58,"initial phase of grain filling",tis_theta_grain
+grain_brown,2.0,0.20,0.22,"on the plant at harvest",tis_theta_grain
